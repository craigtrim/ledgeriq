// VPC Infrastructure - LedgerIQ Serverless Platform

Internet [icon: globe, color: blue] {
  Slack API [icon: slack]
}

VPC us-west-2 [icon: aws-vpc, color: blue] {

  Public Subnets (Multi-AZ) [icon: aws-subnet, color: green] {
    Internet Gateway [icon: aws-internet-gateway]
    NAT Gateways (AZ-A, AZ-B) [icon: aws-nat-gateway]
  }

  Private Subnets (Multi-AZ) [icon: aws-subnet, color: orange] {

    Compute Layer [icon: aws-lambda, color: orange] {
      Lambda Functions (17) [icon: aws-lambda]
      Step Functions [icon: aws-step-functions]
    }

    Public Endpoints [icon: aws-endpoints, color: yellow] {
      Lambda Function URLs [icon: aws-lambda]
      API Gateway [icon: aws-api-gateway]
    }
  }

  VPC Endpoints [icon: aws-privatelink, color: purple] {

    Gateway Endpoints [icon: aws-s3, color: green] {
      S3 Gateway [icon: aws-s3]
    }

    Interface Endpoints [icon: aws-privatelink, color: purple] {
      Bedrock [icon: aws-bedrock]
      Textract [icon: aws-textract]
    }
  }
}

AWS Managed Services [icon: aws, color: orange] {

  AI-ML [icon: aws-bedrock, color: purple] {
    Bedrock (Claude 4.5 Sonnet) [icon: aws-bedrock]
    Textract (OCR) [icon: aws-textract]
  }

  Storage [icon: aws-s3, color: green] {
    S3 (ledgeriq bucket) [icon: aws-s3]
  }
}

// Network Flow (Critical Paths)

// Inbound: Slack to VPC
Slack API > Lambda Function URLs

// Outbound: VPC to Slack
NAT Gateways (AZ-A, AZ-B) > Slack API

// Private Connectivity: VPC to AWS Services
S3 Gateway > S3 (ledgeriq bucket)
Interface Endpoints > Bedrock (Claude 4.5 Sonnet)
Interface Endpoints > Textract (OCR)

// Internal: Compute orchestration
Lambda Functions (17) > Step Functions
